# netwarden settings for Docker (env_file) or the Linux service (/etc/netwarden/netwarden.env).
# Copy to netwarden.env and fill in what you use. Keep the real file private (chmod 600):
# it holds passwords and API keys. Every line is optional.

# --- DNS filter (pick one) -------------------------------------------------------------
# AdGuard Home: its web UI address + the admin user you created in its setup wizard
#ADGUARD_URL=http://192.168.1.2:80
#ADGUARD_USER=admin
#ADGUARD_PASS=change-me
# Pi-hole v6 instead (an app password is best: Settings -> Web interface / API):
#NETWARDEN_DNS_SOURCE=pihole
#PIHOLE_URL=http://192.168.1.3
#PIHOLE_PASSWORD=change-me
# https:// with the source's own self-signed certificate only (certificates are
# verified by default; turn the check off only on a network you trust):
#PIHOLE_VERIFY_TLS=0
#ADGUARD_VERIFY_TLS=0

# --- Optional: bytes per device from ntopng ------------------------------------------
#NTOPNG_URL=http://192.168.1.4:3000
#NTOPNG_USER=admin
#NTOPNG_PASS=change-me
# or an API token instead of user + password (ntopng: user settings -> API token)
#NTOPNG_TOKEN=change-me
#NTOPNG_VERIFY_TLS=0

# --- The AI (optional; without a key netwarden uses its offline summary) --------------
#ANTHROPIC_API_KEY=sk-ant-...
# or a local OpenAI-compatible server (Ollama, LM Studio): docs/private_ai.md
#NETWARDEN_AI_PROVIDER=openai_compat
#NETWARDEN_AI_BASE_URL=http://192.168.1.5:11434/v1
#NETWARDEN_AI_MODEL=llama3.2

# --- Language, time zone, retention --------------------------------------------------
#NETWARDEN_LANG=en
# (unset: the container's TZ variable, e.g. TZ=Europe/Berlin, then its /etc/localtime)
#NETWARDEN_TZ=Europe/Berlin
#NETWARDEN_RETENTION_DAYS=90

# --- Where phones reach the dashboard (bridge networking / reverse proxy only) ----------
#NETWARDEN_ADVERTISED_URL=http://192.168.1.20:8787
